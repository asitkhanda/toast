<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Release builds inject these from Toast/Resources/Info.plist. Keep only
         safe development defaults here so this file cannot become stale. -->
    <ToastVersion Condition="'$(ToastVersion)' == ''">0.0.0</ToastVersion>
    <ToastBuild Condition="'$(ToastBuild)' == ''">0</ToastBuild>
  </PropertyGroup>
</Project>
